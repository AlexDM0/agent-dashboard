{
  // DOM library and no Bun or Node types, so a web module reaching for `Bun.file` or `node:fs` fails to compile.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": []
  },
  // The one shared file the web reaches, so the contract compiles under DOM-only options too.
  "include": ["./**/*.ts", "./**/*.tsx", "../src/shared/DashboardContract.ts"],
  // The specs and the test-only fixtures stay out, so this program's surface is the page that ships.
  "exclude": ["./**/*.spec.ts", "./testing/**"]
}
